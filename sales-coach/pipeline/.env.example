# Copy to pipeline/.env and fill in. Never commit the filled-in copy.
# .gitignore already excludes it.

# Who you are. The seller side of every call and every email.
SELLER_EMAIL=you@yourcompany.com
SELLER_NAME=Your Name

# Where everything is written. Defaults to ~/sales-coach.
# SALES_COACH_HOME=/Users/you/sales-coach

# How far back prompt 1 looks.
LOOKBACK_MONTHS=12

# Fireflies. Settings, then Developer Settings, then API key.
FIREFLIES_API_KEY=

# Gemini. aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CONCURRENCY=3

# Gmail. An OAuth access token with the gmail.readonly scope.
# There is no API-key path for Gmail. The token is short lived, so generate
# one right before the run.
GMAIL_ACCESS_TOKEN=

# HubSpot. A private app token with crm.objects.contacts.read and
# crm.objects.deals.read.
HUBSPOT_TOKEN=

# Jev, the judge. transport is mcp or http.
#   mcp  spawns `npx -y @jkudish/jev-mcp` and needs TYPESAFE_API_KEY
#   http posts to JEV_URL
JEV_TRANSPORT=mcp
JEV_TOOL=jev_verify
TYPESAFE_API_KEY=
# JEV_URL=
JEV_CONCURRENCY=8

# The pattern guard. A question becomes a pattern only when the gap between
# closed won and closed lost is at least MIN_GAP_PP percentage points, both
# groups have at least MIN_SAMPLE records, and the two-proportion test comes
# in under ALPHA. Loosen these and the findings start inventing advice.
MIN_SAMPLE=10
MIN_GAP_PP=15
ALPHA=0.05
