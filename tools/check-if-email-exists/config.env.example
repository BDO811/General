# Copy to config.env on the probe host and fill in. config.env is gitignored.
#
# The verification identity. Deliberately NOT @amplifierhealth.com: SMTP probing
# attracts blocklist attention, and a dedicated subdomain keeps any reputation
# damage off the corporate sending domain.
FROM_EMAIL="probe@verify.amplifierhealth.com"

# The name sent in the EHLO command. Must equal the probe host's PTR record, and
# its A record must point back at the probe host's public IP (forward-confirmed
# reverse DNS). Receivers check this.
HELLO_NAME="mail.verify.amplifierhealth.com"

# SMTP port for the probe. 25 is the only port inbound MX servers listen on,
# so change this only when routing through something that remaps it.
SMTP_PORT="25"

# Note on per-provider methods: the upstream README documents flags such as
# --gmail-verif-method and --yahoo-verif-method. The v0.11.7 CLI binary does not
# have them, they exist only in the HTTP backend. Every check from the CLI is a
# plain SMTP probe. Gmail, Yahoo and Outlook consumer addresses therefore return
# lower-confidence verdicts from the CLI than from the backend.

# Optional SOCKS5 proxy, for hosts where outbound port 25 is blocked.
# PROXY_HOST=""
# PROXY_PORT="1080"
# PROXY_USERNAME=""
# PROXY_PASSWORD=""

# Batch pacing. Seconds between checks, and seconds of extra pause every
# BATCH_PAUSE_EVERY checks. Slow is the point: fast looks like an attack.
SLEEP_SECONDS="5"
BATCH_PAUSE_EVERY="50"
BATCH_PAUSE_SECONDS="60"
